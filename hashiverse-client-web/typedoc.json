{
	"entryPoints": ["src"],
	"entryPointStrategy": "expand",
	"exclude": ["**/node_modules/**", "**/env.d.ts"],
	"out": "docs",
	"name": "hashiverse-client-web",
	"readme": "none",
	"tsconfig": "./tsconfig.json",
	"skipErrorChecking": true,
	"cleanOutputDir": true,
	"excludePrivate": false,
	"excludeProtected": false,
	"excludeInternal": false,
	"includeVersion": true,
	"treatWarningsAsErrors": true,
	"externalSymbolLinkMappings": {
		"hashiverse-client-wasm": {
			"HashiverseClientWasm": "/dev/hashiverse-rust/hashiverse_client_wasm/struct.HashiverseClientWasm.html"
		}
	},
	"navigationLinks": {
		"Hashiverse": "https://www.hashiverse.com"
	}
}
