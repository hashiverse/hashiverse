[Unit]
Description=Daily hashiverse-server upgrade check

[Timer]
OnCalendar=daily
# Spread nodes' upgrade restarts over a day so the network never restarts all at once.
# FixedRandomDelay keeps each machine's offset stable from day to day.
RandomizedDelaySec=24h
FixedRandomDelay=true
# Catch up after downtime.
Persistent=true

[Install]
WantedBy=timers.target
