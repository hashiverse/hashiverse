[Unit]
Description=Hashiverse server (decentralized social network node)
Documentation=https://www.hashiverse.com
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Extra arguments (log level, port, ...) live in this file; edit it, then `systemctl restart hashiverse-server`.
EnvironmentFile=-/etc/default/hashiverse-server
# The server identity (and its one-off ~5 hour proof-of-work) is persisted under --base-path,
# so restarts and upgrades reuse it.
ExecStart=/usr/bin/hashiverse-server --base-path /var/lib/hashiverse-server $HASHIVERSE_SERVER_ARGS
# The server shuts down gracefully on Ctrl+C (SIGINT); systemd's default SIGTERM would just kill it.
KillSignal=SIGINT
TimeoutStopSec=30
Restart=always
RestartSec=5
# A node holds many concurrent peer and client connections.
LimitNOFILE=65536
# Runs as root: it binds :443 and manages its ipset/iptables DDoS block list.

# Sandbox. Exercised by packaging/test (the stand-in binary probes what is allowed and denied).
# Root, but only with the networking capabilities it needs: binding :443, and ipset/iptables.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
RestrictSUIDSGID=yes
# /usr, /boot, /efi and /etc read-only; /home, /root and /run/user hidden.
# "full", not "strict": iptables needs a writable /run/xtables.lock, and the data dir
# /var/lib/hashiverse-server stays writable.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
# AF_NETLINK for ipset/iptables. ProtectKernelModules is deliberately off so that the kernel
# can still autoload the ip_set/xt_set modules on first use.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX

[Install]
WantedBy=multi-user.target
