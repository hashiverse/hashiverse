---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import { strings_for } from "../i18n/strings";
import page_dates from "../generated/page_dates.json";
import {
  PUBLISHED_DATE,
  build_article_schema,
  build_breadcrumb_list,
  safe_json_ld,
} from "../utils/schema";

interface Props {
  title: string;
  description?: string;
  sidebar?: { href: string; label: string; children?: { href: string; label: string }[] }[];
  banner?: string;
  article_type?: "Article" | "TechArticle";
}

const { title, description, sidebar = [], banner, article_type = "TechArticle" } = Astro.props;
const current = Astro.url.pathname;
const locale = Astro.currentLocale ?? "en";
const t = strings_for(locale);

const normalize_path = (path: string): string => {
  const trimmed = path.replace(/\/$/, "");
  return trimmed === "" ? "/" : trimmed;
};

const linear_pages = sidebar.filter((s) => !s.children && !s.href.startsWith("http"));
const current_normalized = normalize_path(current);
const current_index = linear_pages.findIndex((p) => normalize_path(p.href) === current_normalized);
const next_page = current_index >= 0 && current_index < linear_pages.length - 1
  ? linear_pages[current_index + 1]
  : null;

// page_dates.json keys are locale-prefixed pathnames (e.g. "/en/dev/cryptography"),
// matching Astro.url.pathname; no locale-stripping needed.
const page_dates_map = page_dates as Record<string, string>;
const date_modified = page_dates_map[current_normalized] ?? PUBLISHED_DATE;
const canonical_href = Astro.site ? new URL(current, Astro.site).href : current;

const effective_description = description ?? t.site.default_description;

const article_schema = build_article_schema({
  page_type: article_type,
  headline: title,
  description: effective_description,
  locale,
  url: canonical_href,
  date_modified,
});

const section_segment = current_normalized.split("/")[2] ?? "";
const section_label =
  section_segment === "lore" ? t.nav.lore :
  section_segment === "dev" ? t.nav.dev :
  null;
const section_href = section_label
  ? (Astro.site ? new URL(`/${locale}/${section_segment}/`, Astro.site).href : `/${locale}/${section_segment}/`)
  : null;
const home_href = Astro.site ? new URL(`/${locale}/`, Astro.site).href : `/${locale}/`;

const breadcrumb_items = [
  { name: t.site.title_suffix, url: home_href },
  ...(section_label && section_href ? [{ name: section_label, url: section_href }] : []),
  { name: title, url: canonical_href },
];
const breadcrumb_schema = build_breadcrumb_list(breadcrumb_items);
---

<Base
  title={title}
  description={description}
  page_type="article"
  article_published_time={PUBLISHED_DATE}
  article_modified_time={date_modified}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={safe_json_ld(article_schema)} />
    <script type="application/ld+json" set:html={safe_json_ld(breadcrumb_schema)} />
  </Fragment>
  <Nav />
  <div class="layout">
    {sidebar.length > 0 && (
      <button
        type="button"
        class="sidebar-toggle"
        aria-controls="doc-sidebar"
        aria-expanded="false"
        data-sidebar-toggle
      >
        <span>{t.nav.contents}</span>
        <span class="chev" aria-hidden="true">▾</span>
      </button>
      <aside id="doc-sidebar" data-sidebar>
        <nav>
          {sidebar.map((section) => (
            <div class="section">
              <a href={section.href} class:list={[{ active: current === section.href }]}>
                {section.label}
              </a>
              {section.children && (
                <ul>
                  {section.children.map((item) => (
                    <li>
                      <a href={item.href} class:list={[{ active: current === item.href }]}>
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </nav>
      </aside>
    )}
    <main>
      <h1>{title}</h1>
      {banner && <img src={banner} alt="" class="page-banner" />}
      <slot />
      {next_page && (
        <div class="page-next-wrap">
          <a href={next_page.href} class="page-next" rel="next">
            <span class="page-next-label">{t.nav.next}</span>
            <span class="page-next-title">{next_page.label}</span>
            <span class="page-next-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      )}
    </main>
  </div>
</Base>

<script>
  const sidebar_toggle = document.querySelector<HTMLButtonElement>("[data-sidebar-toggle]");
  const sidebar_el = document.querySelector<HTMLElement>("[data-sidebar]");

  sidebar_toggle?.addEventListener("click", () => {
    if (!sidebar_el) return;
    const is_open = sidebar_el.classList.toggle("open");
    sidebar_toggle.setAttribute("aria-expanded", is_open ? "true" : "false");
  });
</script>

<style>
  .layout {
    display: flex;
    min-height: calc(100vh - 57px);
  }

  aside {
    width: 240px;
    flex-shrink: 0;
    border-right: 1px solid var(--border);
    padding: 2rem 1.5rem;
  }

  aside nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-bottom: 0.75rem;
  }

  aside a {
    color: var(--text-muted);
    font-size: 0.875rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    display: block;
    transition: color 0.15s, background 0.15s;
  }

  aside a:hover,
  aside a.active {
    color: var(--accent);
    background: var(--bg-raised);
    text-decoration: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.75rem;
  }

  main {
    flex: 1;
    min-width: 0;
    padding: 2.5rem 3rem;
    max-width: 820px;
  }

  .page-banner {
    float: right;
    width: min(300px, 40vw);
    margin: 0 0 1.5rem 2rem;
    border-radius: 8px;
  }

  .page-next-wrap {
    clear: both;
    display: flex;
    justify-content: flex-end;
    margin-top: 3rem;
  }

  .page-next {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.75rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-raised);
    color: var(--accent);
    text-decoration: none;
    font-size: 0.95rem;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }

  .page-next:hover {
    border-color: var(--accent);
    background: var(--bg-surface);
    color: var(--accent-bright);
    text-decoration: none;
  }

  .page-next-label {
    color: var(--text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-next-title {
    font-weight: 600;
  }

  .page-next-arrow {
    margin-left: 0.15rem;
  }

  .sidebar-toggle {
    display: none;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    padding: 0.85rem 1rem;
    cursor: pointer;
    color: var(--text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.15s;
  }

  .sidebar-toggle:hover {
    color: var(--accent);
  }

  .sidebar-toggle .chev {
    transition: transform 0.2s;
  }

  .sidebar-toggle[aria-expanded="true"] .chev {
    transform: rotate(180deg);
  }

  @media (max-width: 720px) {
    .layout {
      flex-direction: column;
      min-height: auto;
    }

    .sidebar-toggle {
      display: flex;
    }

    aside {
      width: 100%;
      border-right: none;
      border-bottom: 1px solid var(--border);
      padding: 0.75rem 1rem 1rem;
      display: none;
    }

    aside.open {
      display: block;
    }

    main {
      padding: 1.5rem 1rem;
      max-width: 100%;
    }

    main h1 {
      font-size: 1.6rem;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
    }

    main :global(h2) {
      font-size: 1.2rem;
      margin: 1.5rem 0 0.5rem;
    }

    main :global(h3) {
      font-size: 1rem;
    }

    .page-banner {
      float: none;
      width: 100%;
      max-width: 400px;
      margin: 0 auto 1.5rem;
      display: block;
    }
  }

  main h1 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }

  main :global(h2) { font-size: 1.4rem; margin: 2rem 0 0.75rem; }
  main :global(h3) { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; color: var(--text-muted); }
  main :global(p)  { margin: 0 0 1rem; }
  main :global(ul), main :global(ol) { margin: 0 0 1rem 1.5rem; }
  main :global(li) { margin-bottom: 0.25rem; }
  main :global(blockquote) {
    border-left: 3px solid var(--accent);
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    background: var(--bg-raised);
    border-radius: 0 4px 4px 0;
    font-style: italic;
    color: var(--text-muted);
  }
  main :global(blockquote p) { margin: 0 0 0.5rem; }
  main :global(blockquote p:last-child) { margin: 0; }
</style>
