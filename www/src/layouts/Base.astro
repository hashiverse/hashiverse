---
import { strings_for, supported_locales } from "../i18n/strings";
import {
  OG_IMAGE_URL,
  build_organization_schema,
  build_software_application_schema,
  build_website_schema,
  safe_json_ld,
} from "../utils/schema";

interface Props {
  title: string;
  description?: string;
  fullscreen?: boolean;
  page_type?: "website" | "article";
  article_published_time?: string;
  article_modified_time?: string;
}

const locale = Astro.currentLocale ?? "en";
const t = strings_for(locale);

const {
  title,
  description = t.site.default_description,
  fullscreen = false,
  page_type = "website",
  article_published_time,
  article_modified_time,
} = Astro.props;
const prerelease_tag = import.meta.env.PUBLIC_PRERELEASE_TAG;

const path_without_locale = Astro.url.pathname.replace(/^\/[a-z]{2}(\/|$)/, "/");
const canonical_href = Astro.site ? new URL(`/${locale}${path_without_locale}`, Astro.site).href : `/${locale}${path_without_locale}`;
const alternate_href = (l: string) => Astro.site ? new URL(`/${l}${path_without_locale}`, Astro.site).href : `/${l}${path_without_locale}`;
const x_default_href = Astro.site ? new URL("/", Astro.site).href : "/";

const full_title = title === t.site.title_suffix ? t.site.title_suffix : `${title} — ${t.site.title_suffix}`;
const og_image_alt = `${t.site.title_suffix} — ${description}`;
const alternate_locales = supported_locales.filter((l) => l !== locale);

const organization_schema = build_organization_schema();
const website_schema = build_website_schema(t.site.default_description);
const software_application_schema = build_software_application_schema(t.site.default_description);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{full_title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical_href} />
    {supported_locales.map((l) => (
      <link rel="alternate" hreflang={l} href={alternate_href(l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={x_default_href} />

    <meta property="og:type" content={page_type} />
    <meta property="og:site_name" content={t.site.title_suffix} />
    <meta property="og:title" content={full_title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical_href} />
    <meta property="og:locale" content={locale} />
    {alternate_locales.map((l) => (
      <meta property="og:locale:alternate" content={l} />
    ))}
    <meta property="og:image" content={OG_IMAGE_URL} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={og_image_alt} />
    <meta property="og:image:type" content="image/jpeg" />
    {page_type === "article" && article_published_time && (
      <meta property="article:published_time" content={article_published_time} />
    )}
    {page_type === "article" && article_modified_time && (
      <meta property="article:modified_time" content={article_modified_time} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full_title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE_URL} />
    <meta name="twitter:image:alt" content={og_image_alt} />

    <script type="application/ld+json" set:html={safe_json_ld(organization_schema)} />
    <script type="application/ld+json" set:html={safe_json_ld(website_schema)} />
    <script type="application/ld+json" set:html={safe_json_ld(software_application_schema)} />

    <slot name="head" />
  </head>
  <body class:list={[{ fullscreen }]}>
    {prerelease_tag && (
      <div class="prerelease-banner">{t.site.prerelease_label}: {prerelease_tag}</div>
    )}
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg:          #221100;
    --bg-raised:   #2c1600;
    --bg-surface:  #361b00;
    --accent:      #c87820;
    --accent-bright: #e89030;
    --text:        #e8d5b0;
    --text-muted:  #8a6a40;
    --border:      #3d2200;
    --code-bg:     #1a0d00;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, sans-serif;
    line-height: 1.6;
  }

  body.fullscreen {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  a { color: var(--accent); text-decoration: none; }
  a:hover { color: var(--accent-bright); text-decoration: underline; }

  h1, h2, h3, h4 {
    color: var(--text);
    line-height: 1.2;
  }

  code {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.1em 0.4em;
    font-size: 0.875em;
    font-family: "Courier New", monospace;
  }

  pre {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.25rem;
    overflow-x: auto;
  }

  pre code {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.875rem;
  }

  .prerelease-banner {
    position: fixed;
    bottom: 0.75rem;
    left: 0.75rem;
    z-index: 9999;
    background: #c87820;
    color: #221100;
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 0.7rem;
    padding: 0.15rem 0.55rem;
    letter-spacing: 0.02em;
    border-radius: 3px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
    pointer-events: none;
  }
</style>
