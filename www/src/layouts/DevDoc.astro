---
import { getRelativeLocaleUrl } from "astro:i18n";
import Doc from "./Doc.astro";
import { strings_for } from "../i18n/strings";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const locale = Astro.currentLocale ?? "en";
const t = strings_for(locale);
const url = (path: string) => getRelativeLocaleUrl(locale, path);

const sidebar = [
  { href: url("/dev/"), label: t.dev_sidebar.index },
  { href: url("/dev/cryptography"), label: t.dev_sidebar.cryptography },
  { href: url("/dev/pow"), label: t.dev_sidebar.pow },
  { href: url("/dev/network"), label: t.dev_sidebar.network },
  { href: url("/dev/posts"), label: t.dev_sidebar.posts },
  { href: url("/dev/moderation"), label: t.dev_sidebar.moderation },
  { href: url("/dev/resilience"), label: t.dev_sidebar.resilience },
  { href: url("/dev/future"), label: t.dev_sidebar.future },
  { href: url("/dev/geeking-out"), label: t.dev_sidebar.geeking_out },
  {
    href: "https://github.com/hashiverse",
    label: t.dev_sidebar.api_reference,
    children: [
      { href: "/dev/hashiverse-rust/hashiverse_lib/", label: "hashiverse_lib" },
      { href: "/dev/hashiverse-rust/hashiverse_server_lib/", label: "hashiverse_server_lib" },
      { href: "/dev/hashiverse-rust/hashiverse_server/", label: "hashiverse_server" },
      { href: "/dev/hashiverse-rust/hashiverse_client_wasm/", label: "hashiverse_client_wasm" },
      { href: "/dev/hashiverse-client-web/", label: "hashiverse-client-web" },
    ],
  },
];
---

<Doc title={title} description={description} sidebar={sidebar}>
  <slot />
</Doc>
