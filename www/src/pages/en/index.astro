---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
---

<Base title="Hashiverse">
    <Nav/>

    <!-- Hero -->
    <section class="hero">
        <div class="hero-content">
            <h1 class="hero-headline">Hashiverse is <em>your</em> open-source Twitter/X.</h1>
            <p class="hero-punch">
                <span style="white-space: nowrap">Your keys.</span>
                <span style="white-space: nowrap">Your posts.</span>
                <span style="white-space: nowrap">Your network.</span>
            </p>
            <p class="hero-sub">
                <span style="white-space: nowrap">No ads (gratis).</span>
                <span style="white-space: nowrap">No owners (libre).</span>
                <span style="white-space: nowrap">No algorithms (franc).</span>
            </p>
            <div class="hero-cta">
                <a id="hero-app-link" href="#" class="btn btn-primary">Try Hashiverse</a>
                <a href="https://github.com/hashiverse" class="btn btn-secondary">View Source</a>
            </div>
        </div>
    </section>

    <!-- Cards -->
    <section class="cards-section">
        <div class="cards">
            <a href="/en/lore/contribute" class="card">
                <h2>Your network</h2>
                <p>
                    Hashiverse runs on hundreds of independent servers, each costing about $5/month to
                    operate. No data center, no corporate infrastructure — just volunteers who believe an
                    open social web is worth having.
                </p>
            </a>
            <a href="/en/lore/invisible-hand" class="card">
                <h2>No owner, no invisible hand</h2>
                <p>
                    Hashiverse is a protocol, not a product. No company can acquire it, no billionaire can
                    reshape it, no board can sell it. No one decides what trends, what gets promoted, or
                    what quietly disappears.
                </p>
            </a>
            <a href="/en/lore/advertising" class="card">
                <h2>No algorithm, no ads, no influence</h2>
                <p>
                    Your timeline is the posts of the people you follow, in the order they're posted. No
                    engagement optimization, no doom-scrolling, no advertising, no profile built from your online behavior.
                </p>
            </a>
            <a href="/en/dev/cryptography" class="card">
                <h2>Cryptographically secure</h2>
                <p>
                    Your posts are signed and encrypted. Nobody can tamper with or quietly suppress your content.
                    Proof-of-work on every request makes spam and hacker attacks economically prohibitive.
                    Post-quantum computing is accounted for from day one, so your network is future-proof.
                </p>
            </a>
        </div>
    </section>

    <!-- Mastodon -->
    <section class="mastodon-section">
        <h2>Doesn't Mastodon do all this already?</h2>
        <p class="mastodon-intro">
            Mastodon proved that federated social media could work at scale, and the fediverse
            community deserves real credit for that. But federation and true decentralization are
            not the same thing.
        </p>
        <div class="cards">
            <div class="card">
                <h2>Identity</h2>
                <p>
                    Your Mastodon identity is tied to your Mastodon home server. If your admin shuts down the server,
                    you lose your handle and your history. In Hashiverse, your identity is a cryptographic
                    key pair on your device — no one issued it, no one can revoke it.
                </p>
            </div>
            <div class="card">
                <h2>Encryption</h2>
                <p>
                    Mastodon posts are stored in cleartext. Instance administrators can read everything
                    you post and act on it at scale. Hashiverse posts are encrypted at rest — servers store content they
                    cannot easily read.
                </p>
            </div>
            <div class="card">
                <h2>Durability</h2>
                <p>
                    If your Mastodon instance goes offline, or your account is frozen, your posts and followers go with it.
                    Hashiverse distributes your data across multiple independent nodes, and automatically heals itself when
                    servers disappear.
                </p>
            </div>
            <div class="card">
                <h2>Silent curation</h2>
                <p>
                    Mastodon admins can silently filter content, block users, or defederate entire
                    communities. Hashiverse servers can't curate what they can't read. No one quietly
                    decides which voices carry and which don't.
                </p>
            </div>
        </div>
        <p class="mastodon-more"><a href="/en/lore/competitors">Full comparison with X, Bluesky, Mastodon, and Nostr &rarr;</a></p>
    </section>

    <!-- Try it -->
    <section class="try-section">
        <h2>Try Hashiverse</h2>
        <div class="try-grid">
            <div class="try-card">
                <h3>As a user</h3>
                <p>Pick a gateway and start posting:</p>
                <ul class="gateway-list">
                    <li><div class="flag-wrap"><img src="/flags/us.svg" alt="US" class="flag" /></div><a href="https://app.hashiverse.com">app.hashiverse.com</a></li>
                    <li><div class="flag-wrap"><img src="/flags/eu.svg" alt="EU" class="flag" /></div><a href="https://app.hashiverse.eu">app.hashiverse.eu</a></li>
                    <li><div class="flag-wrap"><img src="/flags/ch.svg" alt="CH" class="flag" /></div><a href="https://app.hashiverse.ch">app.hashiverse.ch</a></li>
                </ul>
                <p class="try-showcase">
                    <!-- Showcase bot accounts — coming soon -->
                    Curated showcase accounts for different communities are on the way. Follow them to
                    see Hashiverse in action with content tailored to your interests.
                </p>
            </div>
            <div class="try-card">
                <h3>As a contributor</h3>
                <p>
                    Run a server for about $5/month — a single <code>docker-compose up</code> command on
                    any cheap VPS. Every node you add makes the network stronger, harder to censor, and
                    more useful for everyone.
                </p>
                <a href="/en/lore/contribute" class="btn btn-primary">Get started</a>
            </div>
        </div>
    </section>

    <!-- Early adopter CTA -->
    <section class="early-section">
        <div class="early-inner">
            <h2>Shape the future</h2>
            <p>
                Hashiverse is but an infant. The protocol is live, the network is growing, and the
                core architecture is set — but everything else is being shaped right now. Be part of the early
                community that defines how the world's first truly decentralized social network evolves.
            </p>
            <p>Open source. Open protocol. Open minds.</p>
            <div class="early-links">
                <a href="/en/lore/" class="btn btn-secondary">Lore</a>
                <a href="/en/dev/" class="btn btn-secondary">Dev Docs</a>
                <a href="https://github.com/hashiverse" class="btn btn-secondary">GitHub</a>
            </div>
        </div>
    </section>

    <script>
      import { set_app_link } from "../../utils/app-link";
      set_app_link("hero-app-link");
    </script>
</Base>

<style>
    /* ── Hero ── */
    .hero {
        position: relative;
        width: 100%;
        min-height: 50vh;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        text-align: center;
        background: url('/banner.webp') center center / cover no-repeat;
    }

    .hero-content {
        position: relative;
        z-index: 1;
        width: 100%;
        padding: 2.5rem 2rem;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
    }

    .hero-headline {
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        line-height: 1.2;
        margin: 0 0 0.75rem;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
    }

    .hero-punch {
        color: var(--accent);
        font-size: 1.5rem;
        letter-spacing: 0.02em;
        margin: 0 0 0.5rem;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    }

    .hero-sub {
        color: var(--text-muted);
        font-size: 1.4rem;
        letter-spacing: 0.06em;
        margin: 0 0 2rem;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    }


    .hero-cta {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    /* ── Buttons ── */
    .btn {
        display: inline-block;
        padding: 0.7rem 1.6rem;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-decoration: none;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
    }

    .btn-primary {
        background: var(--accent);
        color: var(--bg);
    }

    .btn-primary:hover {
        background: var(--accent-bright);
        text-decoration: none;
    }

    .btn-secondary {
        background: transparent;
        color: var(--accent);
        border: 1px solid var(--accent);
    }

    .btn-secondary:hover {
        background: var(--bg-raised);
        border-color: var(--accent-bright);
        color: var(--accent-bright);
        text-decoration: none;
    }

    /* ── Cards ── */
    .cards-section {
        padding: 3rem 2rem;
        max-width: 960px;
        margin: 0 auto;
    }

    .cards {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .card {
        background: var(--bg-raised);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1.75rem;
        text-decoration: none;
        transition: border-color 0.15s, background 0.15s;
    }

    .card:hover {
        border-color: var(--accent);
        background: var(--bg-surface);
        text-decoration: none;
    }

    .card h2 {
        font-size: 1.15rem;
        margin: 0 0 0.75rem;
        color: var(--accent);
    }

    .card p {
        margin: 0;
        font-size: 0.925rem;
        line-height: 1.6;
        color: var(--text);
    }

    /* ── Mastodon ── */
    .mastodon-section {
        padding: 3rem 2rem;
        max-width: 960px;
        margin: 0 auto;
    }

    .mastodon-section > h2 {
        font-size: 1.5rem;
        margin: 0 0 0.75rem;
    }

    .mastodon-intro {
        color: var(--text-muted);
        margin: 0 0 1.5rem;
    }

    .mastodon-more {
        font-size: 0.9rem;
        margin: 1.5rem 0 0;
    }

    /* ── Try it ── */
    .try-section {
        padding: 3rem 2rem;
        max-width: 960px;
        margin: 0 auto;
    }

    .try-section > h2 {
        font-size: 1.5rem;
        margin: 0 0 1.5rem;
    }

    .try-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .try-card {
        background: var(--bg-raised);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1.75rem;
    }

    .try-card h3 {
        color: var(--accent);
        font-size: 1.1rem;
        margin: 0 0 0.75rem;
    }

    .try-card p {
        margin: 0 0 1rem;
        font-size: 0.925rem;
        line-height: 1.6;
    }

    .gateway-list {
        list-style: none;
        padding: 0;
        margin: 0 0 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .gateway-list li {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .gateway-list a {
        font-size: 0.925rem;
        font-family: 'Courier New', monospace;
    }

    .flag-wrap {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.6em;
        vertical-align: middle;
    }

    .flag {
        height: 1em;
        border-radius: 2px;
    }

    .try-showcase {
        color: var(--text-muted);
        font-size: 0.85rem;
        font-style: italic;
        margin: 0;
    }

    /* ── Early adopter ── */
    .early-section {
        padding: 3rem 2rem;
        background: var(--bg-raised);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        text-align: center;
    }

    .early-inner {
        max-width: 640px;
        margin: 0 auto;
    }

    .early-inner h2 {
        font-size: 1.5rem;
        margin: 0 0 1rem;
    }

    .early-inner p {
        margin: 0 0 1rem;
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--text);
    }

    .early-links {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 1.5rem;
    }

    /* ── Mobile ── */
    @media (max-width: 720px) {
        .hero {
            padding: 3rem 1.5rem 2.5rem;
        }

        .cards {
            grid-template-columns: 1fr;
        }

        .try-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
